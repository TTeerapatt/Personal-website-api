# personal-website-api
#
# Local development — คัดลอกเป็น `.env`
#   cp .env.example .env
#
# Docker / Jenkins — ส่งผ่าน env หรือ parameter (ไม่ควร bake secret เข้า image)
#
# หมายเหตุ:
# - ถ้า password มีเครื่องหมาย # ใน DATABASE_URL ต้อง encode เป็น %23
# - ถ้ามี DATABASE_URL ระบบจะใช้ค่านี้ก่อน DB_HOST/DB_USER/DB_PASS
# - อัปโหลดไฟล์เก็บที่ /app/upload (docker volume: api_upload)

PORT=3006
NODE_ENV=production

DATABASE_URL=postgres://postgres:CHANGE_ME%23@127.0.0.1:5432/personal_website
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=CHANGE_ME#
DB_NAME=personal_website

JWT_SECRET=change-me-to-a-long-random-string

# frontend origin (คั่นด้วย comma ได้ หรือ *) เช่น admin :3007
CORS_ORIGIN=*
